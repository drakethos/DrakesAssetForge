    /// <summary>Folder with the PNGs the items use (Assets\ next to the mod's DLL).</summary>
    internal static string AssetsFolder = "";

    private static readonly Dictionary<string, Texture2D> Textures = new(StringComparer.OrdinalIgnoreCase);

    // Unity 6 adds a ReadOnlySpan overload net481 can't compile against; bind the byte[] one explicitly.
    private static readonly Func<Texture2D, byte[], bool> LoadImage = (Func<Texture2D, byte[], bool>)Delegate.CreateDelegate(
        typeof(Func<Texture2D, byte[], bool>),
        typeof(ImageConversion).GetMethod(nameof(ImageConversion.LoadImage), new[] { typeof(Texture2D), typeof(byte[]) })!);

    // ---- textures & icons ----

    /// <param name="normalMap">Linear, and repacked to Unity's (A = x, G = y) layout, since a PNG isn't imported as a normal map at runtime.</param>
    internal static Texture2D? Texture(string file, bool normalMap = false)
    {
        var key = normalMap ? file + "|normal" : file;
        if (Textures.TryGetValue(key, out var cached))
            return cached;
        var path = Path.Combine(AssetsFolder, file);
        if (!File.Exists(path))
        {
            Logger.LogWarning($"Missing texture {path}");
            return null;
        }

        var texture = new Texture2D(2, 2, TextureFormat.RGBA32, true, normalMap) { name = Path.GetFileNameWithoutExtension(path) };
        if (!LoadImage(texture, File.ReadAllBytes(path)))
        {
            Logger.LogWarning($"{path} is not a readable PNG or JPG");
            return null;
        }

        if (normalMap)
        {
            var pixels = texture.GetPixels32();
            for (var i = 0; i < pixels.Length; i++)
                pixels[i] = new Color32(255, pixels[i].g, pixels[i].g, pixels[i].r);
            texture.SetPixels32(pixels);
            texture.Apply(true);
        }

        Textures[key] = texture;
        return texture;
    }

