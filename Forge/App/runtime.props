<Project>
  <!--
    Ship Forge Runtime next to the app: the DLL (Settings can install it into a profile) and its source
    (the C# mod export compiles Forge straight into the user's mod). Both come from Forge/Runtime + Forge/Format.
  -->
  <PropertyGroup>
    <ForgeRuntimeDll>$(MSBuildThisFileDirectory)..\Runtime\bin\$(Configuration)\DrakesForgeRuntime.dll</ForgeRuntimeDll>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(ForgeRuntimeDll)" Link="runtime\DrakesForgeRuntime.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(ForgeRuntimeDll)')" />
    <None Include="..\Runtime\*.cs" Exclude="..\Runtime\ForgeRuntimePlugin.cs" LinkBase="forge-src\Runtime" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Format\**\*.cs" Exclude="..\Format\obj\**;..\Format\bin\**" LinkBase="forge-src\Format" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
