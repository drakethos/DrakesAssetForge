<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool: exercises Forge.Valheim against the real install. dotnet run, then prefab names as arguments (e.g. iron_grate SwordBronze) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- AssetsTools' PNG export uses this but doesn't declare it. -->
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Valheim\Forge.Valheim.csproj" />
  </ItemGroup>
</Project>
