<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads the player's Valheim install (SoftRef bundles) for browsing and preview. Read-only; nothing here is ever packed into a mod. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DrakesForge.Valheim</RootNamespace>
    <AssemblyName>DrakesForge.Valheim</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="AssetsTools.NET.Texture" Version="3.0.2" />
    <!-- SoftRef bundles carry no type trees for Valheim scripts; field layouts come from the game's own DLLs. -->
    <PackageReference Include="AssetsTools.NET.MonoCecil" Version="3.0.2" />
    <!-- Field types (enum names, flags) for the component editor. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
