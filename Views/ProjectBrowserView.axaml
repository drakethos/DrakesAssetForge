<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DrakeAssetForge.ViewModels"
             xmlns:models="using:DrakeAssetForge.Models"
             x:Class="DrakeAssetForge.Views.ProjectBrowserView"
             x:DataType="vm:MainViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <TextBlock FontWeight="SemiBold" Text="Project items" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Open folder"
                        Command="{Binding RevealOwnedItemFolderCommand}"
                        IsEnabled="{Binding HasOwnedSelection}" />
                <Button Grid.Column="2"
                        Content="Save"
                        Command="{Binding SaveOwnedItemCommand}"
                        IsEnabled="{Binding HasOwnedSelection}" />
            </Grid>
            <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                       Text="{Binding ProjectPathLabel}" />
            <Border Padding="8" CornerRadius="4" Background="#22006633">
                <TextBlock FontSize="12" TextWrapping="Wrap"
                           Text="Test Art: select an item → Inspector tab Art → Browse an icon PNG. Preview should swap off the SoftRef donor. Mesh/diffuse attach the same way (compile later)." />
            </Border>
        </StackPanel>

        <ListBox Margin="0,8,0,0"
                 ItemsSource="{Binding OwnedItems}"
                 SelectedItem="{Binding SelectedOwnedItem}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:OwnedItemDocument">
                    <StackPanel Spacing="2" Margin="0,4">
                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                        <TextBlock Opacity="0.65" FontSize="11"
                                   Text="{Binding Donor.PrefabName, StringFormat=donor: {0}}" />
                        <TextBlock Opacity="0.8" FontSize="11"
                                   Text="{Binding ArtBadgeDisplay}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
