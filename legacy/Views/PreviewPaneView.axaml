<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DrakeAssetForge.ViewModels"
             xmlns:views="using:DrakeAssetForge.Views"
             x:Class="DrakeAssetForge.Views.PreviewPaneView"
             x:DataType="vm:MainViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock FontWeight="SemiBold" Text="Preview" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshPreviewCommand}" />
            </Grid>

            <Border Height="340"
                    CornerRadius="6"
                    Background="#22888888"
                    HorizontalAlignment="Stretch"
                    ClipToBounds="True">
                <Panel>
                    <views:MeshOrbitView MeshPath="{Binding MeshPreviewPath}"
                                         DiffusePath="{Binding MeshDiffusePath}"
                                         IsVisible="{Binding HasMeshPreview}" />
                    <Image Source="{Binding PreviewBitmap}"
                           IsVisible="{Binding ShowIconPreview}"
                           Stretch="Uniform"
                           Margin="8" />
                    <TextBlock Text="{Binding PreviewCaption}"
                               IsVisible="{Binding ShowPreviewPlaceholder}"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="12"
                               Opacity="0.85" />
                </Panel>
            </Border>

            <TextBlock Text="{Binding PreviewCaption}"
                       IsVisible="{Binding HasPreviewImage}"
                       FontSize="12"
                       Opacity="0.8"
                       TextWrapping="Wrap" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox PlaceholderText="Filter bundle objects…"
                         Text="{Binding ObjectFilter}" />
                <Button Grid.Column="1"
                        Content="Open bundle"
                        Command="{Binding RevealSelectedAssetBundleCommand}" />
            </Grid>
            <TextBlock Opacity="0.7" Text="Bundle objects — select Texture/Mesh for preview" FontSize="12" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding BundleObjects}"
                  SelectedItem="{Binding SelectedBundleObject}"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="90" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="PathId" Binding="{Binding PathId}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
